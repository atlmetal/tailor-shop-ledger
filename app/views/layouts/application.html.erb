<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app_name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# The paper of the page, so the phone's status bar blends with it. %>
    <meta name="theme-color" content="#f4f3ef">
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <%# A form that redirects back to its page morphs it in place, so the page keeps its scroll. %>
    <%= turbo_refresh_method_tag :morph %>
    <%= turbo_refresh_scroll_tag :preserve %>

    <link rel="icon" href="/icon-192.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-paper font-sans text-base text-ink">
    <%= render "layouts/header" %>

    <%# On phones the bottom padding keeps the end of the page clear of the tab bar. %>
    <main class="mx-auto max-w-160 px-4 pt-0.5 pb-26 lg:pt-10 lg:pb-16">
      <%= flash_messages %>

      <%= yield %>
    </main>
  </body>
</html>
