<section class="mt-5" aria-labelledby="advances">
  <div class="flex items-center justify-between gap-3">
    <h2 id="advances" class="text-xl font-extrabold"><%= t(".title") %></h2>
    <%= link_to t(".new"), new_advance_path, class: "btn-link text-note" %>
  </div>

  <div class="panel mt-2.5 divide-y divide-divider">
    <% rows.each do |row| %>
      <%= link_to advance_path(row.advance), class: "flex min-h-17 items-center justify-between gap-3 py-3 pr-3 pl-4 hover:bg-paper" do %>
        <span class="flex min-w-0 flex-col gap-0.5">
          <span class="font-bold"><%= row.advance.customer_name %></span>
          <span class="text-meta text-graphite"><%= balance_word row.balance %></span>
        </span>
        <span class="flex shrink-0 items-center gap-1.5">
          <span class="font-mono text-lg font-bold"><%= pesos(row.balance.abs) %></span>
          <svg aria-hidden="true" class="size-5 text-graphite" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>
        </span>
      <% end %>
    <% end %>
  </div>
</section>
