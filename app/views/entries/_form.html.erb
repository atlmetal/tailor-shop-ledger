<%= form_with model: entry, url: entry_path_for(entry), class: "mt-5 flex flex-col gap-5" do |form| %>
  <div>
    <%= form.label :occurred_on, class: "form-label" %>
    <%= record_date_field form, :occurred_on %>
    <%= field_error entry, :occurred_on %>
  </div>

  <div>
    <%= form.label :concept, t(".concept.#{entry.kind}"), class: "form-label" %>
    <%= form.text_field :concept, required: true, autocomplete: "off", placeholder: t(".placeholder.#{entry.kind}"), class: "form-input" %>
    <%= field_error entry, :concept %>
  </div>

  <div>
    <%= form.label :amount, class: "form-label" %>
    <%= money_field form, :amount, required: true, placeholder: "0" %>
    <%= field_error entry, :amount %>
  </div>

  <p class="panel flex items-start gap-2.5 rounded-small px-3.5 py-3 text-note">
    <svg aria-hidden="true" class="mt-0.5 size-5.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 11v6" /><path d="M12 7.5v.5" /></svg>
    <span><%= t(".note.#{entry.kind}") %></span>
  </p>

  <%= yield form %>
<% end %>
