<section class="mt-8" aria-labelledby="latest-entries">
  <h2 id="latest-entries" class="text-xl font-extrabold"><%= t(".title.#{kind}") %></h2>

  <div class="panel mt-2.5 divide-y divide-divider">
    <% entries.each do |entry| %>
      <%= link_to edit_entry_path_for(entry), class: "flex min-h-16 items-center justify-between gap-3 px-4 py-2.5 hover:bg-paper" do %>
        <span class="flex min-w-0 flex-col gap-0.5">
          <span class="font-bold"><%= entry.concept %></span>
          <span class="text-meta text-graphite"><%= l(entry.occurred_on, format: :day_month) %></span>
        </span>
        <span class="font-mono text-lg font-bold"><%= pesos(entry.amount) %></span>
      <% end %>
    <% end %>
  </div>
</section>
