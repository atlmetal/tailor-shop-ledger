<h1 class="page-title"><%= t(".title") %></h1>

<h2 class="mt-5 text-xl font-extrabold"><%= t(".change_password") %></h2>

<%= form_with model: @user, url: account_path, method: :patch, class: "mt-4 space-y-5" do |form| %>
  <div>
    <%= form.label :password_challenge, class: "form-label" %>
    <%= form.password_field :password_challenge, required: true, autocomplete: "current-password", maxlength: 72, class: "form-input" %>
    <%= field_error @user, :password_challenge %>
  </div>

  <div>
    <%= form.label :password, t(".new_password"), class: "form-label" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "form-input" %>
    <%= field_error @user, :password %>
  </div>

  <div>
    <%= form.label :password_confirmation, class: "form-label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "form-input" %>
    <%= field_error @user, :password_confirmation %>
  </div>

  <%= form.submit t(".submit"), class: "btn-primary" %>
<% end %>

<%= button_to t(".sign_out"), session_path, method: :delete, class: "btn-secondary", form_class: "mt-10 border-t border-edge pt-6" %>
