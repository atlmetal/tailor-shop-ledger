<h1 class="page-title"><%= t(".title") %></h1>

<%= render layout: "form", locals: { advance: @advance } do |form| %>
  <p class="panel flex items-start gap-2.5 rounded-small px-3.5 py-3 text-note">
    <svg aria-hidden="true" class="mt-0.5 size-5.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 11v6" /><path d="M12 7.5v.5" /></svg>
    <span><%= t("advances.new.note") %></span>
  </p>

  <div class="flex gap-2.5">
    <%= form.submit t("advances.new.continue"), class: "btn-primary flex-1" %>
    <%= link_to t("advances.form.cancel"), root_path, class: "btn-secondary w-auto" %>
  </div>
<% end %>
