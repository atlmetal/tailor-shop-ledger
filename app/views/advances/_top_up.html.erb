<%= link_to edit_advance_top_up_path(top_up.advance, top_up), class: "flex min-h-16 items-center justify-between gap-3 py-2.5 pr-3 pl-4 hover:bg-paper" do %>
  <span class="font-bold"><%= day_title(top_up.paid_on) %></span>
  <span class="flex shrink-0 items-center gap-1.5">
    <span class="font-mono text-lg font-bold"><%= pesos(top_up.amount) %></span>
    <svg aria-hidden="true" class="size-5 text-graphite" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>
  </span>
<% end %>
