<h1 class="page-title"><%= t(".title") %></h1>

<%= form_with url: session_url, class: "mt-5 space-y-5" do |form| %>
  <div>
    <%= form.label :email_address, t(".email_address"), class: "form-label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "form-input" %>
  </div>

  <div>
    <%= form.label :password, t(".password"), class: "form-label" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "form-input" %>
  </div>

  <%= form.submit t(".submit"), class: "btn-primary" %>
<% end %>
