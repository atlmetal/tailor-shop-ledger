<%= link_to edit_entry_path_for(entry), class: "flex min-h-17 items-center justify-between gap-3 py-3 pr-3 pl-4 hover:bg-paper" do %>
  <span class="flex min-w-0 flex-col gap-0.5">
    <span class="font-bold"><%= entry.concept %></span>
    <span class="text-meta text-graphite"><%= t(".#{entry.kind}") %></span>
  </span>
  <span class="flex shrink-0 items-center gap-1.5">
    <span class="font-mono text-lg font-bold"><%= pesos(entry.amount) %></span>
    <svg aria-hidden="true" class="size-5 text-graphite" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>
  </span>
<% end %>
