<div class="panel flex flex-col gap-2 p-4" data-job-form-target="balance" data-balance="<%= balance %>">
  <div class="flex justify-between gap-3">
    <span><%= t(".balance") %></span>
    <span class="font-mono font-medium"><%= pesos(balance) %></span>
  </div>
  <div class="flex justify-between gap-3">
    <span><%= t(".this_job") %></span>
    <span class="font-mono font-medium" data-job-form-target="jobCharged"><%= pesos(-job.charged) %></span>
  </div>
  <div aria-hidden="true" class="my-1 border-t-2 border-dashed border-tick"></div>
  <%= tag.div class: "flex items-baseline justify-between gap-3", hidden: owes, data: { job_form_target: "left" } do %>
    <span class="font-extrabold"><%= t(".left") %></span>
    <span class="font-mono text-2xl font-bold" data-job-form-target="leftAmount"><%= pesos(left) %></span>
  <% end %>
  <%= tag.p class: "flex items-start gap-2.5 rounded-small border border-loss-edge bg-loss px-3.5 py-3 font-bold text-loss-ink", role: "status", hidden: !owes, data: { job_form_target: "debt" } do %>
    <svg aria-hidden="true" class="mt-0.5 size-5.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5.5" /><path d="M12 16.5v.5" /></svg>
    <span><%= t(".debt_html", amount: tag.span(pesos(-left), class: "font-mono", data: { job_form_target: "debtAmount" })) %></span>
  <% end %>
</div>
