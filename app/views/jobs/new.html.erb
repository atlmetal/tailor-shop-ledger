<h1 class="page-title"><%= t(".title") %></h1>

<%= render "shared/record_switch" %>

<%= job_saved_notice %>

<p class="panel mt-5 flex items-start gap-2.5 rounded-small px-3.5 py-3 text-note">
  <svg aria-hidden="true" class="mt-0.5 size-5.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 11v6" /><path d="M12 7.5v.5" /></svg>
  <span><%= t(".note") %></span>
</p>

<%= render layout: "form", locals: { job: @job, services: @services } do |form| %>
  <div class="flex flex-col gap-2.5">
    <%= form.submit t("jobs.form.save"), class: "btn-primary" %>
    <%= form.button t("jobs.form.save_and_another"), name: "another", value: "1", class: "btn-secondary" %>
  </div>
<% end %>
